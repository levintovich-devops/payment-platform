@Library('platform-shared-library') _

pipeline {
    agent {
        label 'docker'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh '''
                    echo "Build payment-service"
                    go build ./...
                '''
            }
        }

        stage('Unit Tests') {
            steps {
                sh '''
                    go test ./... -v
                '''
             }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    pwd
                    ls -la
                    docker build -t payment-service:local .
                '''
            }
        }
    }
}
