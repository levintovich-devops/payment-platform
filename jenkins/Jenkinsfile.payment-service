@Library('platform-shared-library') _

pipeline {
    agent {
        label 'docker'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'echo "Build payment-service"'
                go build ./...
            }
        }

        stage('Test') {
            steps {
                sh 'echo "Run tests"'
            }
        }
    }
}
