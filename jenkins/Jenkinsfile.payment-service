@Library('platform-shared-library') _

pipeline {
    agent {
        label 'docker'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh '''
                    echo "Build payment-service"
                    go build ./...
                '''
            }
        }

        stage('Unit Tests') {
            steps {
                sh '''
                    go test ./... -v
                '''
             }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    docker build \
                        -f services/payment-service/Dockerfile \
                        -t payment-service:local .
                '''
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
	        
                        docker tag payment-service:local \
                            levintovich/payment-service:latest
	        
                        docker push levintovich/payment-service:latest	        
                        docker logout
                    '''
                }
            }
        }
    }
}
