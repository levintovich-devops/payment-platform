{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaymentCaptured",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string"
    },
    "eventType": {
      "type": "string",
      "const": "PaymentCaptured"
    },
    "eventVersion": {
      "type": "string",
      "const": "1.0"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": [
        "paymentId",
        "reference",
        "amount",
        "currency",
        "status"
      ],
      "properties": {
        "paymentId": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        },
        "amount": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "const": "CAPTURED"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}